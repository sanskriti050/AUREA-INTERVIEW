# Copy this file to .env and fill in your values
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"

DATABASE_URL=sqlite:///./aurea_v2.db
# DATABASE_URL=postgresql://aurea_user:yourpassword@localhost:5432/aurea_v2

SECRET_KEY=CHANGE_THIS_GENERATE_WITH_SECRETS_TOKEN_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

GROQ_API_KEY=your_groq_api_key_here
# Optional but recommended for real semantic resume ↔ JD matching.
# Use an OpenAI-compatible embeddings provider; this value never goes in frontend/.env.local.
EMBEDDING_API_KEY=your_embedding_provider_key_here
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
JUDGE0_API_KEY=your_judge0_rapidapi_key_here
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com

RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_MINUTE=20
ADMIN_EMAILS=admin@example.com

APP_ENV=development
FRONTEND_URL=http://localhost:3000
